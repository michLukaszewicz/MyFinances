# Base URL the frontend uses for API calls.
# Leave unset in dev — Vite's dev-server proxy (see vite.config.ts) forwards
# /api/* to http://localhost:5007 so no CORS setup is needed locally.
# Set to the deployed API's full URL when the frontend is hosted separately from the API.
# VITE_API_BASE_URL=https://my-finances-api.azurewebsites.net

# Playwright E2E test user (local Postgres container only; see playwright.config.ts)
E2E_USERNAME=
E2E_PASSWORD=
# Optional: override the app port (default 5007) or the throwaway DB port (default 55432)
# E2E_PORT=
# E2E_DB_PORT=
